{
  "app": {
    "name": "RedisPubSub",
    "service": "nearby-friends-worker",
    "instance": "local",
    "version": "1.0.0"
  },
  "logger": {
    "level": "information",
    "console": {
      "enabled": true
    },
    "file": {
      "enabled": false,
      "path": "logs/logs.txt",
      "interval": "hour"
    }
  },
  "postgres": {
    "connectionString": "Host=postgres;Port=5432;Database=nearbyfriends;Username=postgres;Password=postgres"
  },
  "redis": {
    "connectionString": "localhost:6379"
  }
}
